auto-install-peers=true
engine-strict=true

# The workspace includes ../hsm-adapter-ts/packages/*, whose @buf/* dependencies come
# from the Buf Schema Registry. pnpm reads registry settings only from the workspace
# root .npmrc, so hsm-adapter-ts's own .npmrc is never consulted from here and this
# line has to be duplicated, or @buf/* resolves against npmjs.org and 404s.
@buf:registry=https://buf.build/gen/npm/v1/
