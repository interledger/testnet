      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "max by (service_name, service_instance_id) (nodejs_eventloop_delay_p99_seconds{service_name=~\"$service\"})",
          "legendFormat": "{{service_name}} {{service_instance_id}}"
        }
      ]
    }
  ]
}
