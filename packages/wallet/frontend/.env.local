COOKIE_NAME=testnet.cookie

# Separate hosts locally, so the browser needs the absolute address.
BACKEND_URL=https://api.testnet.test

# SSR and the middleware go direct, skipping Traefik's self-signed certificate.
BACKEND_INTERNAL_URL=http://localhost:3003

AUTH_HOST=https://auth.testnet.test
OPEN_PAYMENTS_HOST=https://rafiki-backend.testnet.test
GATEHUB_ENV=sandbox
THEME=dark
FEATURES_ENABLED=false

# Traces and metrics to the local collector (local/observability.yaml). Off
# here, because that stack is opt-in: `pnpm dev:observability` starts it and
# sets TELEMETRY_ENABLED=true, which wins over this file. See Grafana at
# https://grafana.testnet.test.
TELEMETRY_ENABLED=false
TELEMETRY_ENDPOINT=localhost:4317
TELEMETRY_INSECURE=true
SERVICE_ENV=local
