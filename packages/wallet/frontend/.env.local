COOKIE_NAME=testnet.cookie

# The frontend is served at https://testnet.test and the backend at
# https://api.testnet.test, so the browser needs the absolute address. A bare
# path would only work if one host served both.
BACKEND_URL=https://api.testnet.test

# Server-side rendering and the middleware talk to the backend directly, over
# plain HTTP, and skip Traefik and its self-signed certificate.
BACKEND_INTERNAL_URL=http://localhost:3003

AUTH_HOST=https://auth.testnet.test
OPEN_PAYMENTS_HOST=https://rafiki-backend.testnet.test
GATEHUB_ENV=sandbox
THEME=dark
FEATURES_ENABLED=false
