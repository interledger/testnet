FROM node:24-slim

# Set the working directory
WORKDIR /home/testnet

RUN apt-get update && \
    apt-get install -y python3 build-essential && \
    apt-get clean

# Install PNPM
RUN corepack enable
RUN corepack prepare pnpm@9.1.4 --activate

# Copy lockfile, NVM and NPM configuration to the working directory
COPY pnpm-lock.yaml .nvmrc .npmrc ./

# Fetch packages from lockfile (https://pnpm.io/cli/fetch#usage-scenario)
RUN pnpm fetch

# Add everything to the working directory
ADD . ./

# Install packages from virtual store
RUN pnpm install --filter @wallet/frontend... --offline

# This image takes no build arguments. The frontend reads every URL, the theme
# and the feature flags from the environment when it answers a request, so pass
# them to the container instead. See packages/wallet/frontend/.env.example.

CMD ["pnpm", "wallet:frontend", "dev"]
