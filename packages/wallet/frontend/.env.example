# Copy this file to .env.local and adjust the values to run the wallet frontend
# locally. If you create both .env.local and .env, values in .env win.
#
# Every variable here is read when the server answers a request, not when the
# bundle is built. `pnpm wallet:frontend dev` picks up an edit on the next
# request, and a production image picks it up on the next pod restart.
#
# None of these names carries a `NEXT_PUBLIC_` prefix, and none should. Next.js
# replaces every `process.env.NEXT_PUBLIC_*` expression with a literal when it
# builds, which is what used to tie a deployment URL to an image tag. See
# src/lib/runtimeConfig.ts.

########## SESSION AND INTERNAL BACKEND #########################################################

# COOKIE_NAME=testnet.cookie

# The address this process uses for the backend. It keeps server-side rendering
# and the middleware off Traefik and its self-signed certificate. It is
# required when BACKEND_URL is a path.
# BACKEND_INTERNAL_URL=http://localhost:3003

########## BROWSER-FACING CONFIG #################################################################
## The server writes these into every page, and the browser reads them back.

# The address the browser uses for the backend. Absolute where the backend has
# a hostname of its own, which is the local setup. Where one hostname serves
# the frontend at / and the backend at a prefix, use the path instead
# (BACKEND_URL=/wallet-api): a path follows whatever host served the page, so
# it survives a DNS change without an edit.
# BACKEND_URL=https://api.testnet.test

# AUTH_HOST=https://auth.testnet.test
# OPEN_PAYMENTS_HOST=https://rafiki-backend.testnet.test

# THEME=light

######### Controlling branding and features ######################################################
# FEATURES_ENABLED controls the wallet UI mode (frontend only):
# - true: enables "Interledger Wallet" mode (wallet branding, card/deposit-first flows,
#   cards menu visibility, card-related labels in transactions, and production-style auth copy)
# - false: enables "Test Wallet" mode (test branding, test-only hints, and cards visibility
#   controlled by per-user settings instead of forced-on)
# If omitted, it defaults to false only when NODE_ENV=production and GATEHUB_ENV=sandbox,
# otherwise it defaults to true.

# NODE_ENV=production
# GATEHUB_ENV=production
# FEATURES_ENABLED=true
